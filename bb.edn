{:tasks
 {serve     {:doc "Start the mock tenant: bb serve [port] [tenant-dir]"
             :task (apply shell "clojure" "-M" "-m" "sling.server" *command-line-args*)}
  deploy    {:doc "PUT tenant/ to a tenant API: bb deploy --base URL --token T [--dry-run]"
             :task (load-file "bb/deploy.bb")}
  login     {:doc "Drive /authenticate like a client: bb login --base URL --user U --password P [--otp C] [--ip IP]"
             :task (load-file "bb/login.bb")}
  normalize {:doc "Rewrite tenant/ files in canonical form (sorted keys), as after a Frodo export"
             :task (shell "clojure" "-M" "-e" "(require 'sling.store) (sling.store/normalize! \"tenant\" \"alpha\")")}}}
