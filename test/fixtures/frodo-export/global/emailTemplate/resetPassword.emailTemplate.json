{
  "emailTemplate" : {
    "resetPassword" : {
      "_id" : "emailTemplate/resetPassword",
      "enabled" : true,
      "from" : "noreply@example.test",
      "subject" : {
        "en" : "Reset your password"
      },
      "message" : {
        "en" : "<p>Hello {{object.givenName}}, <a href=\"{{object.resumeURI}}\">reset your password</a>.</p>"
      }
    }
  }
}