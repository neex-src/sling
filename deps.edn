{:paths ["src" "resources" "test"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        org.graalvm.polyglot/polyglot {:mvn/version "24.1.1"}
        org.graalvm.polyglot/js-community {:mvn/version "24.1.1" :extension "pom"}}
 :aliases
 ;; Spring Security's own token checking (JwtDecoders, the path a Spring Boot resource server
 ;; takes) is in :test so the tests prove a real consumer accepts the fake's tokens. The REPL
 ;; (:nrepl) carries it too, since the tests run there.
 {:test {:extra-paths ["test"]
         :extra-deps {org.springframework.security/spring-security-oauth2-jose {:mvn/version "6.3.4"}
                      org.springframework.security/spring-security-oauth2-resource-server {:mvn/version "6.3.4"}
                      org.springframework/spring-web {:mvn/version "6.1.14"}}}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                       cider/cider-nrepl {:mvn/version "0.50.2"}
                       org.springframework.security/spring-security-oauth2-jose {:mvn/version "6.3.4"}
                       org.springframework.security/spring-security-oauth2-resource-server {:mvn/version "6.3.4"}
                       org.springframework/spring-web {:mvn/version "6.1.14"}
                       com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.17.2"}}
          :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}}
