{
  "_id": "sync/alphaUser_systemHrdbAccount",
  "consentRequired": false,
  "correlationQuery": [
    {
      "linkQualifier": "default",
      "source": "({ _queryFilter: \"__NAME__ eq \\\"\" + source.userName + \"\\\"\" });",
      "type": "text/javascript"
    }
  ],
  "displayName": "Users to the HR database",
  "enableSync": {
    "$bool": "&{esv.hrdb.sync}"
  },
  "name": "alphaUser_systemHrdbAccount",
  "onCreate": {
    "globals": {},
    "source": "target.organization = \"WEB\";",
    "type": "text/javascript"
  },
  "policies": [
    {
      "action": "CREATE",
      "situation": "ABSENT"
    },
    {
      "action": "UPDATE",
      "situation": "CONFIRMED"
    },
    {
      "action": "UPDATE",
      "situation": "FOUND"
    },
    {
      "action": "DELETE",
      "situation": "UNQUALIFIED"
    },
    {
      "action": "DELETE",
      "situation": "SOURCE_MISSING"
    },
    {
      "action": "CREATE",
      "situation": "MISSING"
    }
  ],
  "properties": [
    {
      "source": "userName",
      "target": "__NAME__"
    },
    {
      "source": "givenName",
      "target": "firstname"
    },
    {
      "source": "sn",
      "target": "lastname"
    },
    {
      "source": "mail",
      "target": "email"
    },
    {
      "source": "",
      "target": "fullname",
      "transform": {
        "globals": {},
        "source": "[source.givenName, source.sn].filter(function (x) { return x; }).join(\" \");",
        "type": "text/javascript"
      }
    }
  ],
  "source": "managed/alpha_user",
  "target": "system/HRDB/__ACCOUNT__",
  "validSource": {
    "globals": {},
    "source": "source.accountStatus === \"active\";",
    "type": "text/javascript"
  }
}
